# Copy to build.properties or pass these properties on the Ant command line.
# Paths depend on the installed Java ME SDK / Wireless Toolkit.
# Run: ant doctor  (or npm run check:j2me-toolchain from gateway/)
cldc.api.jar=/absolute/path/to/cldc-api.jar
midp.api.jar=/absolute/path/to/midp-api.jar
preverify.executable=/absolute/path/to/preverify
# Recommended on modern JDKs: ECJ supports legacy Java 1.3 source and
# classfile target 1.1 modes. Acquire it with:
#   cd gateway && node scripts/acquire-ecj.js
# The default acquired location is tools/ecj-4.41.jar at the project root.
compiler.backend=ecj
ecj.jar=tools/ecj-4.41.jar

# Legacy desktop javac fallback (not supported by current JDK releases):
# javac.source=1.3
# javac.target=1.1
